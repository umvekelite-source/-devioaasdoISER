diff --git a/Telegram/SourceFiles/main/main_session.cpp b/Telegram/SourceFiles/main/main_session.cpp
index c8d9e2a..e19b56f 100644
--- a/Telegram/SourceFiles/main/main_session.cpp
+++ b/Telegram/SourceFiles/main/main_session.cpp
@@ -102,6 +102,40 @@ void Session::handleUpdate(const MTPDupdateDeleteMessages &update) {
+    // DEVIOS Anti-Delete Engine
+    // Intercept deletion updates instead of stripping messages from the local SQLite/memory structure.
+    const auto &ids = update.vmessages().v;
+    for (const auto &id : ids) {
+        if (const auto message = this->data().message(this->channelId(), id.v)) {
+            // Set local deletion flag on metadata layer to retain in dialogue list
+            message->setDeletedLocally(true);
+            
+            // Broadcast structural notification to Qt UI component for custom rendering update
+            this->data().requestViewRepaint(message);
+        }
+    }
+    return; // Block default removal update execution
+}
+
+void Session::handleUpdate(const MTPDupdateEditMessage &update) {
+    // DEVIOS Anti-Edit Engine
+    // Retain previous message data prior to overwriting it.
+    const auto &msg = update.vmessage();
+    msg.match([&](const MTPDmessage &data) {
+        if (const auto localMsg = this->data().message(this->channelId(), data.vid().v)) {
+            // Push the current pre-edited content block into local history cache
+            localMsg->storePreEditHistory(localMsg->text(), localMsg->date());
+        }
+    });
+    
+    // Execute normal update propagation
+    orig_handleUpdate(update);
 }
 
