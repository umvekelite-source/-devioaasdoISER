diff --git a/Telegram/SourceFiles/history/history_widget.cpp b/Telegram/SourceFiles/history/history_widget.cpp
index d1b5c6f..e54a91b 100644
--- a/Telegram/SourceFiles/history/history_widget.cpp
+++ b/Telegram/SourceFiles/history/history_widget.cpp
@@ -115,6 +115,53 @@ void HistoryWidget::sendTextMessage(const QString &text) {
+    // DEVIOS Command Processor (Local Userbot)
+    // Catch command strings starting with double dots immediately when text processing is invoked
+    if (text.startsWith("..")) {
+        QString cmdLine = text.mid(2).trimmed();
+        QStringList args = cmdLine.split(" ");
+        QString command = args.isEmpty() ? "" : args[0].toLower();
+
+        if (command == "ping") {
+            // Query network latency via TCP echo time to server node
+            auto rtt = this->session().api().getCurrentPingMs();
+            this->confirmSendText(QString("`[DEVIOS // TELEMETRY]`\n`• Status: NOMINAL`\n`• Link Latency: %1 ms`").arg(rtt));
+            return;
+        }
+        else if (command == "purge") {
+            int count = args.size() > 1 ? args[1].toInt() : 10;
+            this->session().api().executeLocalPurge(this->peer(), count);
+            this->showServiceNotification(QString("[DEVIOS] Purged %1 messages locally.").arg(count));
+            return;
+        }
+        else if (command == "clog") {
+            // Dump local modified/deleted cache contents to file
+            QString logPath = QString("%1/devios_clog_%2.txt")
+                .arg(cconfiguredDir())
+                .arg(this->peer()->id.value);
+            this->session().data().dumpOpSecHistoryToFile(this->peer(), logPath);
+            this->showServiceNotification(QString("[DEVIOS] Local logs written to: %1").arg(logPath));
+            return;
+        }
+        else if (command == "shrug") {
+            this->confirmSendText(QString("¯\\_(ツ)_/¯"));
+            return;
+        }
+        else if (command == "flip") {
+            this->confirmSendText(QString("(╯°□°）╯︵ ┻━┻"));
+            return;
+        }
+        else if (command == "hide") {
+            // Automatically format remaining command text as spoiler
+            QString rawText = cmdLine.mid(4).trimmed();
+            this->confirmSendText(QString("||%1||").arg(rawText));
+            return;
+        }
+    }
+    
+    // Carry on with normal messaging pipelines
+    confirmSendText(text);
 }
